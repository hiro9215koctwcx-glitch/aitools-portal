        attachPreview.classList.add("is-visible");
        attachments.forEach(function (item) {
          var chip = document.createElement("div");
          chip.className = "attach-chip";
          chip.dataset.id = String(item.id);

          if (item.kind === "image" && item.dataUrl) {
            var img = document.createElement("img");
            img.className = "attach-chip__thumb";
            img.src = item.dataUrl;
            img.alt = item.name;
            chip.appendChild(img);
          } else {
            var icon = document.createElement("div");
            icon.className = "attach-chip__icon";
            icon.textContent = "PDF";
            chip.appendChild(icon);
          }

          var meta = document.createElement("div");
          meta.className = "attach-chip__meta";
          var label = document.createElement("div");
          label.className = "attach-chip__label";
          label.textContent = "Хавсаргасан";
          var name = document.createElement("div");
          name.className = "attach-chip__name";
          name.textContent = item.name;
          name.title = item.name;
          meta.appendChild(label);
          meta.appendChild(name);
          chip.appendChild(meta);

          var removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "attach-chip__remove";
          removeBtn.setAttribute("aria-label", item.name + "-г устгах");
          removeBtn.textContent = "×";
          removeBtn.addEventListener("click", function () {

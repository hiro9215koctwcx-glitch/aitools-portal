      async function prepareQuestionContext(question) {
        if (!storedDocuments.length) {
          return { context: "", sources: [] };
        }

        var searchable = [];
        var legacy = [];
        storedDocuments.forEach(function (doc) {
          if (!doc) return;
          var found = false;
          if (Array.isArray(doc.chunks)) {
            doc.chunks.forEach(function (chunk) {
              var embedding = chunkEmbedding(chunk);
              if (!embedding) return;
              found = true;
              searchable.push({
                name: doc.name,
                text: chunk.text,
                embedding: embedding,
              });
            });
          }
          if (!found && doc.text) legacy.push(doc);
        });

        if (!searchable.length) {
          var legacyOnly = legacyDocumentContext(legacy);
          return {
            context: legacyOnly.blocks.join("\n\n"),
            sources: legacyOnly.names,
          };
        }

        if (!question) {
          var names = [];
          storedDocuments.forEach(function (doc) {
            if (doc && doc.text) rememberSource(names, doc.name);
          });
          return { context: buildSelectedDocumentsContext(), sources: names };
        }

        var openaiKey = (openaiApiKeyInput.value || "").trim();
        if (!openaiKey) {
          showToast("Баримт хайхад OpenAI API түлхүүр хэрэгтэй");
          openaiApiKeyInput.focus();
          return null;
        }

        var queryEmbedding;
        try {
          queryEmbedding = await fetchChunkEmbedding(openaiKey, question);
        } catch (e) {
          console.error("Асуултыг векторжуулж чадсангүй", e);
          showToast("Баримт хайлт амжилтгүй боллоо");
          return null;
        }

        var ranked = [];
        searchable.forEach(function (item) {
          var score = cosineSimilarity(queryEmbedding, item.embedding);
          if (score === null) return;
          ranked.push({ name: item.name, text: item.text, score: score });
        });
        ranked.sort(function (a, b) {
          return b.score - a.score;
        });
        ranked = ranked.slice(0, TOP_K);

        var blocks = [];
        var sources = [];
        ranked.forEach(function (item) {
          blocks.push("【Лавлах баримт: " + item.name + "】\n" + item.text);
          rememberSource(sources, item.name);
        });
        var legacyPart = legacyDocumentContext(legacy);
        legacyPart.blocks.forEach(function (block) {
          blocks.push(block);
        });
        legacyPart.names.forEach(function (name) {
          rememberSource(sources, name);
        });
        return { context: blocks.join("\n\n"), sources: sources };
      }


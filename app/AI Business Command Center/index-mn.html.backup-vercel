      async function addFilesFromList(fileList) {
        var files = Array.prototype.slice.call(fileList || []);
        if (!files.length) return;

        for (var i = 0; i < files.length; i++) {
          if (attachments.length >= MAX_ATTACHMENTS) {
            showToast("Хамгийн ихдээ " + MAX_ATTACHMENTS + " файл хавсаргана");
            break;
          }
          var file = files[i];
          var info = classifyFile(file);
          if (info.kind === "office") {
            showToast("Word, PowerPoint файлыг эхлээд PDF болгож хадгалаад оруулна уу");
            continue;
          }
          if (info.kind === "unsupported") {
            showToast("Дэмжигдэх формат: PDF / PNG / JPG");
            continue;
          }
          if (file.size > MAX_FILE_BYTES) {
            showToast("Файл хэт том байна (20MB хүртэл)");
            continue;
          }
          try {
            var dataUrl = await readFileAsDataUrl(file);
            attachments.push({
              id: attachIdSeq++,
              name: file.name || "file",
              kind: info.kind,
              mediaType: info.mediaType,
              base64: stripDataUrl(dataUrl),
              dataUrl: dataUrl,
            });
          } catch (e) {
            showToast("Файл уншиж чадсангүй");
          }
        }
        renderAttachments();
      }

      (function bindDragAndDrop() {
        var overlay = document.getElementById("dropOverlay");
        if (!overlay) return;

        var dragDepth = 0;

        function showOverlay() {
          overlay.classList.add("is-active");
          overlay.setAttribute("aria-hidden", "false");
        }

        function hideOverlay() {
          overlay.classList.remove("is-active");
          overlay.setAttribute("aria-hidden", "true");
          dragDepth = 0;
        }

        function isFileDrag(e) {
          if (!e.dataTransfer) return false;
          var types = e.dataTransfer.types;
          if (!types) return false;
          for (var i = 0; i < types.length; i++) {
            if (types[i] === "Files") return true;
          }
          return false;
        }

        window.addEventListener("dragenter", function (e) {
          if (!isFileDrag(e)) return;
          e.preventDefault();
          dragDepth++;
          showOverlay();
        });

        window.addEventListener("dragover", function (e) {
          if (!isFileDrag(e)) return;
          e.preventDefault();
          e.dataTransfer.dropEffect = "copy";
        });

        window.addEventListener("dragleave", function (e) {
          if (!isFileDrag(e)) return;
          dragDepth--;
          if (dragDepth <= 0) hideOverlay();
        });

        window.addEventListener("drop", function (e) {
          if (!isFileDrag(e)) return;
          e.preventDefault();
          hideOverlay();
          var files = e.dataTransfer.files;
          if (files && files.length) {
            addFilesFromList(files);
          }
        });

        window.addEventListener("blur", hideOverlay);
      })();

      function buildClaudeUserContent(text, files) {
        var blocks = [];
        (files || []).forEach(function (f) {
          if (f.kind === "pdf") {
            blocks.push({
              type: "document",
              source: {
                type: "base64",
                media_type: "application/pdf",
                data: f.base64,
              },
            });
          } else if (f.kind === "image") {
            blocks.push({
              type: "image",
              source: {
                type: "base64",
                media_type: f.mediaType,
                data: f.base64,
              },
            });
          }
        });
        var prompt =
          text ||
          (files && files.length
            ? "Хавсаргасан файлын агуулгыг харж, гол санааг товч хэлж өгнө үү."
            : "");
        if (prompt) {
          blocks.push({ type: "text", text: prompt });
        }
        return blocks;
      }

      function buildOpenAIUserContent(text, files) {
        var parts = [];
        var prompt =
          text ||
          (files && files.length
            ? "Хавсаргасан файлын агуулгыг харж, гол санааг товч хэлж өгнө үү."

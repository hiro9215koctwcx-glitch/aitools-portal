      function chunkEmbedding(chunk) {
        if (!chunk || typeof chunk.text !== "string" || !chunk.text) return null;
        if (!Array.isArray(chunk.embedding) || !chunk.embedding.length) return null;
        return chunk.embedding;
      }

      function cosineSimilarity(a, b) {
        if (!a || !b || a.length !== b.length || !a.length) return null;
        var dot = 0;
        var normA = 0;
        var normB = 0;
        for (var i = 0; i < a.length; i++) {
          var av = a[i];
          var bv = b[i];
          if (typeof av !== "number" || typeof bv !== "number") return null;
          dot += av * bv;
          normA += av * av;
          normB += bv * bv;
        }
        if (normA === 0 || normB === 0) return null;
        var score = dot / (Math.sqrt(normA) * Math.sqrt(normB));
        return isFinite(score) ? score : null;
      }


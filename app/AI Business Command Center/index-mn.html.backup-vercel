      function takeChunkOverlap(text) {
        var trimmed = String(text || "").trim();
        var overlapLen = 100;
        if (trimmed.length <= overlapLen) return "";
        var cut = trimmed.length - overlapLen;
        var snapped = cut;
        var limit = Math.min(trimmed.length - 1, cut + 30);
        for (var i = cut; i <= limit; i++) {
          var ch = trimmed.charAt(i);
          if (
            ch === "\n" ||
            ch === "。" ||
            ch === "！" ||
            ch === "？" ||
            ch === "." ||
            ch === "!" ||
            ch === "?"
          ) {
            snapped = i + 1;
            break;
          }
        }
        var overlap = trimmed.slice(snapped).trim();
        if (!overlap || overlap.length < 40) {
          overlap = trimmed.slice(trimmed.length - overlapLen).trim();
        }
        return overlap;
      }

      function splitOversizedText(text, maxLen) {
        var sentences = [];
        var buf = "";
        for (var i = 0; i < text.length; i++) {
          var ch = text.charAt(i);
          buf += ch;
          if ("。！？.!?".indexOf(ch) >= 0) {
            sentences.push(buf);
            buf = "";
          }
        }
        if (buf) sentences.push(buf);

        var pieces = [];
        var current = "";

        function pushHard(value) {
          var start = 0;
          while (start < value.length) {
            if (value.length - start <= maxLen) {
              pieces.push(value.slice(start));
              break;
            }
            var end = start + maxLen;
            var cut = end;
            var windowStart = start + Math.min(500, maxLen - 1);
            for (var k = end - 1; k >= windowStart; k--) {
              var c = value.charAt(k);
              if ("、，, \n。".indexOf(c) >= 0) {
                cut = k + 1;
                break;
              }
            }
            if (cut <= start) cut = end;
            pieces.push(value.slice(start, cut));
            start = cut;
          }
        }

        sentences.forEach(function (sentence) {
          if (sentence.length > maxLen) {
            if (current) {
              pieces.push(current);
              current = "";
            }
            pushHard(sentence);
            return;
          }
          if (!current) {
            current = sentence;
            return;
          }
          if ((current + sentence).length <= maxLen) {
            current += sentence;
          } else {
            pieces.push(current);
            current = sentence;
          }
        });
        if (current) pieces.push(current);
        return pieces;
      }

      function splitDocumentChunks(text) {
        var source = String(text || "").replace(/\r\n/g, "\n").trim();
        if (!source) return [];
        var maxChunk = 800;
        var unitMax = 660;
        if (source.length <= maxChunk) return [source];

        var units = [];
        source.split(/\n+/).forEach(function (paragraph) {
          var part = paragraph.trim();
          if (!part) return;
          if (part.length <= unitMax) {
            units.push(part);
          } else {
            splitOversizedText(part, unitMax).forEach(function (piece) {
              if (piece) units.push(piece);
            });
          }
        });
        if (!units.length) return [source];

        var chunks = [];
        var current = "";
        units.forEach(function (unit) {
          if (!current) {
            current = unit;
            return;
          }
          var next = current + "\n" + unit;
          if (next.length <= maxChunk) {
            current = next;
            return;
          }
          chunks.push(current.trim());
          var overlap = takeChunkOverlap(current);
          current = overlap ? overlap + "\n" + unit : unit;
          if (current.length > maxChunk) current = unit;
        });
        if (current.trim()) chunks.push(current.trim());
        return chunks;
      }

      function addDocument(name, text, chunks) {
        var item = {
          id: "d" + docIdSeq++,
          name: name,
          text: text,
          chunks: chunks,
        };
        storedDocuments.push(item);
        if (!saveDocuments()) {
          storedDocuments.pop();
          return false;
        }
        renderDocumentList();
        renderDocRefList();
        return true;
      }

      function deleteDocument(id) {
        storedDocuments = storedDocuments.filter(function (d) {
          return d.id !== id;
        });
        selectedDocIds = selectedDocIds.filter(function (sid) {
          return sid !== id;
        });
        if (!saveDocuments()) {
          showToast("Устгалтыг хадгалж чадсангүй");
        }
        renderDocumentList();
        renderDocRefList();
        showToast("Баримтыг устгалаа");
      }

      function openAddDocForm() {
        addDocForm.classList.add("is-open");
        docNameInput.focus();
      }

      function closeAddDocForm() {
        addDocForm.classList.remove("is-open");
        addDocForm.reset();
      }

      async function fetchChunkEmbedding(apiKey, text) {
        var res = await fetch("https://api.openai.com/v1/embeddings", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + apiKey,
          },
          body: JSON.stringify({
            model: "text-embedding-3-small",
            input: text,
          }),
        });
        if (!res.ok) {
          throw new Error(String(await parseErrorBody(res)));
        }
        var data = await res.json();
        var embedding =
          data && data.data && data.data[0] && data.data[0].embedding;
        if (!Array.isArray(embedding) || !embedding.length) {
          throw new Error("Вектор буцаж ирсэнгүй");
        }
        return embedding;
      }

      async function fetchChunkEmbeddingBatch(apiKey, texts) {
        var res = await fetch("https://api.openai.com/v1/embeddings", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + apiKey,
          },
          body: JSON.stringify({
            model: "text-embedding-3-small",
            input: texts,
          }),
        });
        if (!res.ok) {
          throw new Error(String(await parseErrorBody(res)));
        }
        var data = await res.json();
        var rows = data && data.data;
        if (!Array.isArray(rows)) {
          throw new Error("Вектор буцаж ирсэнгүй");
        }
        var embeddings = new Array(texts.length);
        for (var i = 0; i < rows.length; i++) {
          var row = rows[i];
          var index = row && typeof row.index === "number" ? row.index : i;
          var embedding = row && row.embedding;
          if (
            index < 0 ||
            index >= texts.length ||
            embeddings[index] ||
            !Array.isArray(embedding) ||
            !embedding.length
          ) {
            throw new Error("Векторын дарааллыг баталгаажуулж чадсангүй");
          }
          embeddings[index] = embedding;
        }
        for (var j = 0; j < embeddings.length; j++) {
          if (!embeddings[j]) {
            throw new Error("Вектор буцаж ирсэнгүй");
          }
        }
        return embeddings;
      }

      async function embedDocumentChunks(chunkTexts, apiKey, onProgress) {
        var chunks = [];
        var failures = [];
        for (var i = 0; i < chunkTexts.length; i++) {
          chunks.push({ text: chunkTexts[i] });
        }
        var size = BATCH_SIZE > 0 ? BATCH_SIZE : 20;
        for (var start = 0; start < chunkTexts.length; start += size) {
          var end = Math.min(start + size, chunkTexts.length);
          var batch = chunkTexts.slice(start, end);
          if (onProgress) onProgress(end, chunkTexts.length);
          try {
            var embeddings = await fetchChunkEmbeddingBatch(apiKey, batch);
            for (var k = 0; k < embeddings.length; k++) {
              chunks[start + k].embedding = embeddings[k];
            }
          } catch (e) {
            console.error(
              "Хэсэг " + (start + 1) + "–" + end + "-ийн векторжуулалт амжилтгүй",
              e
            );
            for (var n = start; n < end; n++) {
              failures.push(n + 1);
            }
          }
        }
        return { chunks: chunks, failures: failures };
      }

      function collectPdfFiles(fileList) {
        var pdfs = [];
        var other = 0;
        var oversized = 0;
        for (var i = 0; i < fileList.length; i++) {
          var file = fileList[i];
          if (!file) continue;
          if (classifyFile(file).kind !== "pdf") {
            other++;
            continue;
          }
          if (file.size > MAX_FILE_BYTES) {
            oversized++;
            continue;
          }
          pdfs.push(file);
        }
        return { pdfs: pdfs, other: other, oversized: oversized };
      }

      function nameForDocumentFile(file, typedName, total) {
        if (total === 1 && typedName) return typedName;
        var raw = (file && file.name) || "";
        var base = raw.replace(/\.[^./\\]+$/, "").trim();
        if (!base) base = "Баримт";
        if (base.length > 120) base = base.slice(0, 120);
        return base;
      }

      function setDocRegisterProgress(text) {
        addDocSubmitBtn.textContent = text;
        if (docDropText) docDropText.textContent = text;
      }

      async function storeExtractedDocument(file, name, key, openaiKey, onChunkProgress) {
        var dataUrl = await readFileAsDataUrl(file);
        var fileObj = {
          id: attachIdSeq++,
          name: file.name || "file.pdf",
          kind: "pdf",
          mediaType: "application/pdf",
          base64: stripDataUrl(dataUrl),
          dataUrl: dataUrl,
        };
        var extracted = await callClaudeStream(
          key,
          [
            {
              role: "user",
              content: buildClaudeUserContent(DOC_EXTRACT_PROMPT, [fileObj]),
            },
          ],
          function () {}
        );
        extracted = (extracted || "").trim();
        if (!extracted) {
          throw new Error("Хоосон хариу ирлээ");
        }
        if (extracted.length > MAX_DOC_CHARS) {
          showToast(
            "Бичвэр хэт урт байна (нэг баримтад ойролцоогоор " + MAX_DOC_CHARS + " тэмдэгт)"
          );
          return "rejected";
        }
        var chunkTexts = splitDocumentChunks(extracted);
        var embedded = await embedDocumentChunks(
          chunkTexts,
          openaiKey,
          onChunkProgress
        );
        if (!addDocument(name, extracted, embedded.chunks)) {
          return "rejected";
        }
        if (!embedded.failures.length) return "saved";
        if (embedded.failures.length === chunkTexts.length) return "embed-all";
        return "embed-some";
      }

      async function registerDocuments(fileList) {
        if (docRegistering) return false;
        var incoming = fileList ? Array.prototype.slice.call(fileList) : [];
        if (!incoming.length) {
          showToast("PDF файл сонгоно уу");
          return false;
        }
        var split = collectPdfFiles(incoming);
        if (!split.pdfs.length) {
          if (split.other) showToast("Зөвхөн PDF дэмжинэ");
          else if (split.oversized) {
            showToast("Файл хэт том байна (20MB хүртэл)");
          } else {
            showToast("PDF файл сонгоно уу");
          }
          return false;
        }
        if (split.other) showToast("Зөвхөн PDF дэмжинэ");
        else if (split.oversized) showToast("Файл хэт том байна (20MB хүртэл)");

        var key = (apiKeyInput.value || "").trim();
        if (!key) {
          showToast("Claude API түлхүүрээ оруулна уу");
          apiKeyInput.focus();
          return false;
        }
        var openaiKey = (openaiApiKeyInput.value || "").trim();
        if (!openaiKey) {
          showToast("Векторжуулахад OpenAI API түлхүүр хэрэгтэй");
          openaiApiKeyInput.focus();
          return false;
        }
        if (aiProvider.value !== "claude") {
          showToast("Баримт бүртгэхийг Claude-аар хийнэ үү");
          return false;
        }

        saveApiKey();

        var typedName = (docNameInput.value || "").trim();
        var files = split.pdfs;
        var originalLabel = addDocSubmitBtn.textContent;
        var originalDropText = docDropText ? docDropText.textContent : "";
        addDocSubmitBtn.disabled = true;
        addDocToggleBtn.disabled = true;
        docRegistering = true;
        var saved = 0;
        var embedAll = 0;
        var embedSome = 0;
        var failed = 0;
        try {
          for (var i = 0; i < files.length; i++) {
            var file = files[i];
            var name = nameForDocumentFile(file, typedName, files.length);
            setDocRegisterProgress(
              "Уншиж байна… (" + (i + 1) + "/" + files.length + ")"
            );
            try {
              var outcome = await storeExtractedDocument(
                file,
                name,
                key,
                openaiKey,
                function (current, total) {
                  setDocRegisterProgress(
                    "Вектор болгож байна… (" +
                      (i + 1) +
                      "/" +
                      files.length +
                      " · " +
                      current +
                      "/" +
                      total +
                      " хэсэг)"
                  );
                }
              );
              if (outcome === "saved") saved++;
              else if (outcome === "embed-all") {
                saved++;
                embedAll++;
              } else if (outcome === "embed-some") {
                saved++;
                embedSome++;
              } else {
                failed++;
              }
            } catch (e) {
              failed++;
              var msg = e && e.message ? e.message : "Баримт бүртгэж чадсангүй";
              showToast(msg);
            }
          }
        } finally {
          docRegistering = false;
          addDocSubmitBtn.disabled = false;
          addDocToggleBtn.disabled = false;
          addDocSubmitBtn.textContent = originalLabel;
          if (docDropText) docDropText.textContent = originalDropText;
        }

        if (embedAll || embedSome) {
          showToast(
            embedAll && !embedSome && embedAll === saved
              ? "Векторжуулалт амжилтгүй боллоо"
              : "Зарим хэсгийн векторжуулалт амжилтгүй боллоо"
          );
          closeAddDocForm();
          return false;
        }
        if (failed && saved) {
          showToast("Зарим баримтыг бүртгэж чадсангүй");
          closeAddDocForm();
          return false;
        }
        return saved > 0;
      }

      function bindDocDropZone() {
        if (!docDropZone) return;

        function zoneIsOpen() {
          return (
            addDocForm &&
            addDocForm.classList.contains("is-open") &&
            docDropZone
          );
        }

        function pointerInDocDropZone(e) {
          if (!zoneIsOpen()) return false;
          var rect = docDropZone.getBoundingClientRect();
          if (!rect.width || !rect.height) return false;
          return (
            e.clientX >= rect.left &&
            e.clientX <= rect.right &&
            e.clientY >= rect.top &&
            e.clientY <= rect.bottom
          );
        }

        function allowDocDrop(e) {
          e.preventDefault();
          e.stopPropagation();
          if (e.dataTransfer) e.dataTransfer.dropEffect = "copy";
          docDropZone.classList.add("is-dragover");
        }

        function startDroppedRegistration(files) {
          docDropZone.classList.remove("is-dragover");
          if (!files || !files.length) return;
          registerDocuments(files).then(function (ok) {
            if (ok) {
              closeAddDocForm();
              showToast("Баримтыг бүртгэлээ");
            }
          });
        }

        docDropZone.addEventListener("dragenter", function (e) {
          allowDocDrop(e);
        });
        docDropZone.addEventListener("dragover", function (e) {
          allowDocDrop(e);
        });
        docDropZone.addEventListener("dragleave", function (e) {
          e.preventDefault();
          if (e.relatedTarget && docDropZone.contains(e.relatedTarget)) return;
          if (pointerInDocDropZone(e)) return;
          docDropZone.classList.remove("is-dragover");
        });
        docDropZone.addEventListener("drop", function (e) {
          allowDocDrop(e);
          var files = e.dataTransfer && e.dataTransfer.files;
          startDroppedRegistration(files);
        });

        window.addEventListener(
          "dragover",
          function (e) {
            if (!pointerInDocDropZone(e)) {
              if (docDropZone.classList.contains("is-dragover")) {
                docDropZone.classList.remove("is-dragover");
              }
              return;
            }
            allowDocDrop(e);
          },
          true
        );
        window.addEventListener(
          "drop",
          function (e) {
            if (!pointerInDocDropZone(e)) return;
            allowDocDrop(e);
            var files = e.dataTransfer && e.dataTransfer.files;
            startDroppedRegistration(files);
          },
          true
        );
      }

      function bindDocumentsUi() {
        if (tabDocuments) {
          tabDocuments.addEventListener("click", function () {
            setView("documents");
          });
        }
        addDocToggleBtn.addEventListener("click", function () {
          if (addDocForm.classList.contains("is-open")) {
            closeAddDocForm();
          } else {
            openAddDocForm();
          }
        });
        addDocCancelBtn.addEventListener("click", closeAddDocForm);
        addDocForm.addEventListener("submit", function (e) {
          e.preventDefault();
          registerDocuments(docFileInput.files).then(function (ok) {
            if (ok) {
              closeAddDocForm();
              showToast("Баримтыг бүртгэлээ");
            }
          });
        });
        bindDocDropZone();
      }

      function bindVideoUi() {
        tabChat.addEventListener("click", function () {
          setView("chat");
        });
        tabVideos.addEventListener("click", function () {
          setView("videos");
        });
        if (openVideosNav) {
          openVideosNav.addEventListener("click", function () {
            setView("videos");
          });
          openVideosNav.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              setView("videos");
            }
          });
        }
        addVideoToggleBtn.addEventListener("click", function () {
          if (addVideoForm.classList.contains("is-open")) {
            closeAddForm();
          } else {
            openAddForm();
          }
        });
        addVideoCancelBtn.addEventListener("click", closeAddForm);
        addVideoForm.addEventListener("submit", function (e) {
          e.preventDefault();
          if (addVideo(videoTitleInput.value, videoUrlInput.value)) {
            closeAddForm();
            showToast("Видео нэмлээ");
          }
        });
      }

      restoreStoredSettings();
      restoreTrainingVideos();
      renderVideoList();
      bindVideoUi();
      restoreDocuments();
      renderDocumentList();
      renderDocRefList();
      bindDocumentsUi();
      renderWelcome();
    })();
  </script>

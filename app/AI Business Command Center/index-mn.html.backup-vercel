      padding: 1rem 0.5rem;
      font-size: 0.8rem;
      line-height: 1.5;
      color: var(--text-muted);
      text-align: center;
    }

    .video-player-frame {
      position: relative;
      width: 100%;
      flex: 1;
      min-height: 220px;
      background: #000;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }


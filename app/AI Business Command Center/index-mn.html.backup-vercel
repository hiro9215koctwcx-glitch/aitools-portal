      async function parseErrorBody(res) {
        var raw = await res.text().catch(function () {
          return "";
        });
        try {
          var data = JSON.parse(raw);
          return (
            (data.error && (data.error.message || data.error.type || data.error.code)) ||
            data.message ||
            res.statusText ||
            "API error"
          );
        } catch (e) {
          return raw || res.statusText || "API error";
        }
      }

      async function readSSEStream(res, onDataLine) {
        if (!res.body || !res.body.getReader) {
          throw new Error("Энэ орчинд шууд дамжуулалт (streaming) дэмжигдэхгүй байна");
        }
        var reader = res.body.getReader();
        var decoder = new TextDecoder();
        var buffer = "";
        while (true) {
          var chunk = await reader.read();
          if (chunk.done) break;
          buffer += decoder.decode(chunk.value, { stream: true });
          var lines = buffer.split(/\r?\n/);
          buffer = lines.pop();
          for (var i = 0; i < lines.length; i++) {
            var line = lines[i];
            if (!line || line.charAt(0) === ":") continue;
            if (line.indexOf("data:") === 0) {
              var payload = line.slice(5);
              if (payload.charAt(0) === " ") payload = payload.slice(1);
              if (payload === "[DONE]") continue;
              onDataLine(payload);
            }
          }
        }
        if (buffer) {
          if (buffer.indexOf("data:") === 0) {
            var rest = buffer.slice(5);
            if (rest.charAt(0) === " ") rest = rest.slice(1);
            if (rest && rest !== "[DONE]") onDataLine(rest);
          }
        }
      }

      async function callClaudeStream(apiKey, userMessages, onDelta) {
        var hasPdf = (userMessages || []).some(function (m) {
          return (
            Array.isArray(m.content) &&
            m.content.some(function (b) {
              return b && b.type === "document";
            })
          );
        });
        var headers = {
          "Content-Type": "application/json",
          "x-api-key": apiKey,
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true",
        };
        if (hasPdf) {
          headers["anthropic-beta"] = "pdfs-2024-09-25";
        }
        var res = await fetch("https://api.anthropic.com/v1/messages", {
          method: "POST",
          headers: headers,
          body: JSON.stringify({
            model: "claude-sonnet-4-5",
            max_tokens: 4096,
            stream: true,
            system: SYSTEM_PROMPT + "\nӨнөөдрийн огноо: " + getTodayLabel() + ".",
            messages: userMessages,
          }),
        });
        if (!res.ok) {
          throw new Error(String(await parseErrorBody(res)));
        }
        var full = "";
        await readSSEStream(res, function (payload) {
          var data;
          try {
            data = JSON.parse(payload);
          } catch (e) {
            return;
          }
          if (data.type === "error") {
            var errMsg =
              (data.error && (data.error.message || data.error.type)) ||
              "Claude stream error";
            throw new Error(String(errMsg));
          }
          if (
            data.type === "content_block_delta" &&
            data.delta &&
            data.delta.type === "text_delta" &&
            typeof data.delta.text === "string"
          ) {
            full += data.delta.text;
            onDelta(data.delta.text, full);
          }
        });
        return full;
      }

      async function callOpenAIStream(apiKey, messages, onDelta) {
        var res = await fetch("https://api.openai.com/v1/chat/completions", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: "Bearer " + apiKey,
          },
          body: JSON.stringify({
            model: "gpt-4o-mini",
            stream: true,
            messages: messages,
          }),
        });
        if (!res.ok) {
          throw new Error(String(await parseErrorBody(res)));
        }
        var full = "";
        await readSSEStream(res, function (payload) {
          var data;
          try {
            data = JSON.parse(payload);
          } catch (e) {
            return;
          }
          if (data.error) {
            throw new Error(
              String(data.error.message || data.error.code || "OpenAI stream error")
            );
          }
          var delta =
            data.choices &&
            data.choices[0] &&
            data.choices[0].delta &&
            data.choices[0].delta.content;
          if (typeof delta === "string" && delta) {
            full += delta;
            onDelta(delta, full);
          }
        });
        return full;
      }

      var FIX_SPEECH_PROMPT =
        "Дараах бичвэр дуугаар оруулсан тул алдаа, буруу хөрвүүлэлт байж болно. Агуулгаас нь зөв засаж, байгалийн уншигдахуйц болгоно уу. Утгыг нь бүү өөрчил. Нэмэлт тайлбаргүйгээр зөвхөн зассан бичвэрийг буцаана уу.";

      async function fixSpeechText() {
        var text = (chatInput.value || "").trim();
        if (!text) {
          showToast("Засах бичвэр алга");
          return;
        }

        var provider = aiProvider.value;
        var key =
          provider === "openai"
            ? (openaiApiKeyInput.value || "").trim()
            : (apiKeyInput.value || "").trim();
        if (!key) {
          if (provider === "openai") {
            showToast("OpenAI API түлхүүрээ оруулна уу");
            openaiApiKeyInput.focus();
          } else {
            showToast("Claude API түлхүүрээ оруулна уу");
            apiKeyInput.focus();
          }
          return;
        }

        saveApiKey();

        var originalLabel = fixTextBtn.textContent;
        fixTextBtn.disabled = true;
        fixTextBtn.textContent = "Засаж байна…";
        try {
          var reply;
          var userContent = FIX_SPEECH_PROMPT + "\n\n" + text;
          if (provider === "claude") {
            reply = await callClaudeStream(
              key,
              [{ role: "user", content: userContent }],
              function () {}
            );
          } else {
            reply = await callOpenAIStream(
              key,
              [
                { role: "system", content: FIX_SPEECH_PROMPT },
                { role: "user", content: text },
              ],
              function () {}
            );
          }
          reply = (reply || "").trim();
          if (!reply) {
            throw new Error("Хоосон хариу ирлээ");
          }
          chatInput.value = reply;
          chatInput.focus();
        } catch (e) {
          var msg = e && e.message ? e.message : "Холболт амжилтгүй боллоо";
          showToast(msg);
        } finally {
          fixTextBtn.disabled = false;
          fixTextBtn.textContent = originalLabel;
        }
      }

      async function sendChat() {
        var text = (chatInput.value || "").trim();
        var filesNow = attachments.slice();
        if (!text && !filesNow.length) return;

        var provider = aiProvider.value;
        var key =
          provider === "openai"
            ? (openaiApiKeyInput.value || "").trim()
            : (apiKeyInput.value || "").trim();
        if (!key) {
          if (provider === "openai") {
            showToast("OpenAI API түлхүүрээ оруулна уу");
            openaiApiKeyInput.focus();
          } else {
            showToast("Claude API түлхүүрээ оруулна уу");
            apiKeyInput.focus();
          }
          return;
        }

        if (provider === "openai") {
          var hasPdf = filesNow.some(function (f) {
            return f.kind === "pdf";
          });
          if (hasPdf) {
            showToast("PDF-ийг Claude-аар уншуулна уу");
            return;
          }
        }

        if (sendBtn.disabled) return;
        sendBtn.disabled = true;
        var docContext = await prepareQuestionContext(text);
        if (!docContext) {
          sendBtn.disabled = false;
          return;
        }

        saveApiKey();

        var displayText = formatUserDisplay(text, filesNow);
        var docsBlock = docContext.context;
        var apiText = docsBlock
          ? docsBlock + (text ? "\n\n" + text : "")
          : text;
        chatInput.value = "";
        lastKeyWasEnter = false;
        clearAttachments();

        appendMessage("user", displayText);
        var priorHistory = chatHistory.slice();
        chatHistory.push({ role: "user", content: displayText });

        var assistantEl = appendMessage("assistant", "");
        try {
          var reply;
          function onDelta(_chunk, full) {
            renderAssistantMarkdown(assistantEl, full);
            scrollMessages();
          }
          if (provider === "claude") {
            var claudeMessages = priorHistory.concat([
              { role: "user", content: buildClaudeUserContent(apiText, filesNow) },
            ]);
            reply = await callClaudeStream(key, claudeMessages, onDelta);
          } else {
            var openaiUserContent =
              filesNow.length > 0
                ? buildOpenAIUserContent(apiText, filesNow)
                : apiText;
            var openaiMessages = [
              {
                role: "system",
                content:
                  SYSTEM_PROMPT +
                  "\nӨнөөдрийн огноо: " +
                  getTodayLabel() +
                  ".",
              },
            ].concat(priorHistory);
            openaiMessages.push({
              role: "user",
              content: openaiUserContent,
            });
            reply = await callOpenAIStream(key, openaiMessages, onDelta);
          }
          if (!reply) {
            throw new Error("Хоосон хариу ирлээ");
          }
          renderAssistantMarkdown(assistantEl, reply);
          appendDocSources(assistantEl, docContext.sources);
          scrollMessages();
          chatHistory.push({ role: "assistant", content: reply });
        } catch (e) {
          var msg = e && e.message ? e.message : "Холболт амжилтгүй боллоо";
          if (
            /Failed to fetch|NetworkError|CORS/i.test(msg) &&
            aiProvider.value === "openai"
          ) {
            msg =
              "ChatGPT (OpenAI) хөтчөөс шууд дуудахад заримдаа хаагддаг. Claude руу шилжих эсвэл сүлжээ / CORS-оо шалгана уу.";
          }
          if (assistantEl) {
            assistantEl.textContent = "Алдаа: " + msg;
            scrollMessages();
          } else {
            appendMessage("assistant", "Алдаа: " + msg);
          }
          chatHistory.pop();
        } finally {
          sendBtn.disabled = false;
          chatInput.focus();
        }

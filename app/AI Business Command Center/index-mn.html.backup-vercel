      function extractYoutubeId(rawUrl) {
        var input = (rawUrl || "").trim();
        if (!input) return null;
        try {
          if (!/^https?:\/\//i.test(input)) {
            input = "https://" + input;
          }
          var u = new URL(input);
          var host = (u.hostname || "").replace(/^www\./, "").toLowerCase();
          if (host === "youtu.be") {
            var shortId = (u.pathname || "").replace(/^\//, "").split("/")[0];
            return shortId && /^[\w-]{11}$/.test(shortId) ? shortId : null;
          }
          if (host === "youtube.com" || host === "m.youtube.com" || host === "music.youtube.com") {
            var path = u.pathname || "";
            if (path.indexOf("/embed/") === 0 || path.indexOf("/shorts/") === 0 || path.indexOf("/live/") === 0) {
              var parts = path.split("/").filter(Boolean);
              var fromPath = parts[1] || "";
              return /^[\w-]{11}$/.test(fromPath) ? fromPath : null;
            }
            var v = u.searchParams.get("v");
            return v && /^[\w-]{11}$/.test(v) ? v : null;
          }
        } catch (err) {
          return null;
        }
        return null;
      }


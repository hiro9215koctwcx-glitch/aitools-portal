      }

      .action-grid {
        grid-template-columns: 1fr 1fr;
      }

      .video-layout {
        flex-direction: column;
      }

      .video-side {
        flex: 0 0 auto;
        max-width: 100%;
        max-height: 40vh;
      }

      .video-player-frame {
        min-height: 240px;
